# ADHD Depoet kjører lokal-først uten disse verdiene.
# Når verdiene mangler, skal appen ikke vise innlogging, skylagring eller ekte e-postutsending.
#
# VIKTIG FOR PRODUKSJONSBYGG: ikke kopier denne fila rått til
# .env.production.local. Vite baker inn ALLE VITE_-variabler som er definert,
# også tomme og også VITE_EMAIL_ENABLED=false. Et produksjonsbygg skal bare ha
# de to Supabase-variablene definert — de to andre skal være helt fraværende.
# Se docs/BUILD_AND_DEPLOY.md.

# Frontend: Supabase magic-link og synk aktiveres bare når begge finnes.
# PÅKREVD i produksjonsbygg.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Preview-only: kan settes til den eksplisitt godkjente Pages-callbacken.
# Produksjon skal IKKE definere denne i det hele tatt. Uten den faller
# resolveAuthCallbackUrl tilbake til https://adhd-depoet.com/auth/callback,
# som er ønsket oppførsel.
VITE_AUTH_CALLBACK_URL=

# Frontend: e-postflyt aktiveres bare når server-side Resend/secrets faktisk er klare.
# Produksjon skal IKKE definere denne. Uten den blir emailEnabled false, som er
# dagens tilstand. Å ta med linjen nedenfor i et produksjonsbygg endrer
# bundelen uten å endre oppførselen.
VITE_EMAIL_ENABLED=false

# Cloudflare Pages Functions bruker samme offentlige prosjektinformasjon uten VITE_-prefiks.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-side Supabase Edge Function secrets (aldri VITE_, aldri i frontend-bygget):
# Navngitte nøkler leveres av Supabase gjennom den plattformstyrte SUPABASE_SECRET_KEYS-ordboken.
# RESEND_API_KEY=
# EMAIL_FROM=
# EMAIL_SIGNING_SECRET=
# APP_URL=https://adhd-depoet.com
