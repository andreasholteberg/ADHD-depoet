# ADHD Depoet kjører lokal-først uten disse verdiene.
# Når verdiene mangler, skal appen ikke vise innlogging, skylagring eller ekte e-postutsending.

# Frontend: Supabase magic-link og synk aktiveres bare når begge finnes.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Preview-only: kan settes til den eksplisitt godkjente Pages-callbacken.
# Produksjon skal la denne stå tom og bruker alltid https://adhd-depoet.com/auth/callback.
VITE_AUTH_CALLBACK_URL=

# Frontend: e-postflyt aktiveres bare når server-side Resend/secrets faktisk er klare.
VITE_EMAIL_ENABLED=false

# Cloudflare Pages Functions bruker samme offentlige prosjektinformasjon uten VITE_-prefiks.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Stripe er forberedt kun for testmodus. Disse tre er serverhemmeligheter i Cloudflare,
# aldri VITE_-verdier og aldri lokale/sporede nøkkelverdier.
# APP_URL=https://adhd-depoet.com
# STRIPE_TEST_SECRET_KEY=
# STRIPE_TEST_WEBHOOK_SECRET=
# STRIPE_TEST_PRICE_ID=
# SUPABASE_STRIPE_SECRET_KEY=

# Bunny Stream: tokennøkkelen er serverhemmelighet og brukes til kortlivede embed-URL-er.
# BUNNY_EMBED_TOKEN_KEY=

# Server-side Supabase Edge Function secrets (aldri VITE_, aldri i frontend-bygget):
# Navngitte nøkler leveres av Supabase gjennom den plattformstyrte SUPABASE_SECRET_KEYS-ordboken.
# RESEND_API_KEY=
# EMAIL_FROM=
# EMAIL_SIGNING_SECRET=
# APP_URL=https://adhd-depoet.com
